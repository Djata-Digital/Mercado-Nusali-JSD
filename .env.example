# ==============================================================================
# MERCADO NUSALI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Application & Server
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# URL pública do frontend para os QR codes de rastreamento das etiquetas (sem barra final)
# Exemplo em produção: https://app.mercadonusali.com
VITE_PUBLIC_APP_URL=

# 2. Database - PostgreSQL (Drizzle ORM & Cloud SQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nusali_db"

# 3. Cache & Background Queues - Redis
REDIS_URL="redis://localhost:6379"
ENABLE_BULLMQ="false"
BULLMQ_ROLE="disabled"

# 4. Authentication & Security (JWT & Password Hashing)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="30d"

# 5. Object Storage (S3 / Google Cloud Storage / Cloudflare R2 / MinIO)
STORAGE_PROVIDER="local_s3_compatible"
STORAGE_ENDPOINT="https://storage.googleapis.com"
STORAGE_BUCKET="nusali-public-assets"
STORAGE_REGION="us-east1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# 6. Payment Gateways (Pix, Orange Money, MTN Mobile Money, Nusali Pay)
PIX_PSP_PROVIDER="bacen_direct"
ORANGE_MONEY_API_KEY=""
MTN_MOMO_API_KEY=""

# 7. AI & Gemini Integration
GEMINI_API_KEY=""

# 8. WebSockets
WS_PORT="3000"

# Transactional e-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=Mercado Nusali <no-reply@mail.nusali.com>

# SEO / domínio público canônico (C3.2). NÃO é o mesmo que APP_URL (links de e-mail/reset de senha).
# PUBLIC_APP_URL: origem pública canônica (só origem, sem caminho). Sem ela: nenhum redirect e nenhum X-Robots-Tag por host.
# CANONICAL_HOST_REDIRECT_ENABLED: "true" liga o redirect de PÁGINAS GET/HEAD em host não canônico (ex.: api.mercado.nusali.com -> mercado.nusali.com).
#   A API (/api, /ws, health, webhooks, /assets, em qualquer caixa) NUNCA é redirecionada. Só ligar depois que o domínio canônico estiver no ar com HTTPS.
#   A decisão usa o Host bruto validado (req.headers.host); X-Forwarded-Host é ignorado. Host inválido nunca redireciona.
# CANONICAL_HOST_REDIRECT_STATUS (C3.7C): status do redirect: 302 (default), 301, 307 ou 308. Ausente/inválido = 302.
#   Toda resposta de redirect leva "Cache-Control: no-store". Use 301/308 só depois de validar o canário com 302.
# PUBLIC_APP_URL=https://mercado.nusali.com
# CANONICAL_HOST_REDIRECT_ENABLED=false
# CANONICAL_HOST_REDIRECT_STATUS=302
# HOST_POLICY_SHADOW_MODE (C3.7A, diagnóstico temporário): "true" só adiciona o header X-Host-Policy-Diagnostic
#   (raw=canonical|other|invalid;resolved=canonical|other: classificações, nunca os hosts). NÃO altera nenhuma decisão. Default: desligado.
# HOST_POLICY_SHADOW_MODE=false
EMAIL_VERIFICATION_EXPIRES_MINUTES=10


ASAAS_ENVIRONMENT="sandbox"
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_USER_AGENT="MercadoNusali/1.0 (Node.js; sandbox)"
ASAAS_WEBHOOK_AUTH_TOKEN=""

# Fase 1 do AUTO-RELEASE de escrow: segredo do endpoint interno
# POST /api/v1/internal/jobs/escrow-auto-release (header x-internal-jobs-secret).
# Nunca persistido em platformSettings/banco, nunca exposto ao frontend.
# Sem valor aqui — nunca inventar/commitar um segredo real.
INTERNAL_JOBS_SECRET=""
